<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="6dp"
    android:paddingRight="16dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/rArt"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_panel"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_musica" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/tTitle"
            style="@style/Texto.Fila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tSub"
            style="@style/Texto.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="Escuchado"
        android:src="@drawable/ic_check"
        android:tint="@color/verde"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/rFlecha"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_flecha"
        android:tint="@color/texto3"
        android:visibility="gone" />
</LinearLayout>
